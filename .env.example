# --- OpenSea ---
# Instant key: curl -X POST https://api.opensea.io/api/v2/auth/keys
OPENSEA_API_KEY=
OPENSEA_API=https://api.opensea.io
# Chain slug used in OpenSea API paths (ethereum, base, robinhood, ...)
OPENSEA_CHAIN=robinhood

# --- Collection (change these to retarget the bot) ---
# OpenSea collection slug from the drop URL: opensea.io/collection/<slug>
COLLECTION_SLUG=hoodbirdss
# NFT contract. If you change COLLECTION_SLUG and leave this blank, the bot
# resolves it from the OpenSea drop API (needs OPENSEA_API_KEY).
NFT_ADDRESS=0x14a247e9e3accbc941a705c984a49e291468bc29
# Canonical SeaDrop 1.0 on most EVM chains. Override only if the drop uses another.
SEADROP_ADDRESS=0x00005EA00Ac477B1030CE78506496e8C2dE24bf5
# Optional. If unset, the bot reads the first allowed fee recipient on-chain.
# FEE_RECIPIENT=0x0000a26b00c1F0DF003000390027140000fAa719

# --- Chain ---
CHAIN_ID=4663
CHAIN_NAME=Robinhood Chain
NATIVE_SYMBOL=ETH
RPC_URL=https://rpc.mainnet.chain.robinhood.com
EXPLORER_URL=https://robinhoodchain.blockscout.com

# --- Wallets ---
# CSV columns: index,address,private_key  (or address,private_key)
# Keys may be with or without the 0x prefix.
WALLETS_FILE=./wallets.csv
# Optional: cap how many wallets from the file are used
WALLET_LIMIT=
# Default count for `npm run generate` if you omit --count
GENERATE_COUNT=1

# --- Mint ---
# Tokens per wallet. Must not exceed the drop's max per wallet.
QUANTITY=1
# seadrop = encode mintPublic locally (faster). opensea = POST /drops/{slug}/mint
MODE=seadrop
# Extra native token reserved for gas on top of mint price. Default 0.0002 ETH.
GAS_BUFFER_WEI=200000000000000
RESULTS_FILE=results.json

# --- Funding (optional, used by `npm run fund`) ---
FUNDING_PRIVATE_KEY=
# Native token to leave on each mint wallet after funding
FUND_TARGET_ETH=0.0012
