    "check": "tsx src/index.ts check",
    "generate": "tsx src/index.ts generate",
    "key": "tsx src/index.ts key",
    "fund": "tsx src/index.ts fund",
    "snipe": "tsx src/index.ts snipe",
    "simulate": "tsx src/index.ts simulate",
