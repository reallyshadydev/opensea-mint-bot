{
  "name": "hoodbirds-mint-bot",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Multi-wallet public mint bot for OpenSea SeaDrop collections. Collection and chain are configured via .env.",
  "exports": {
    "./package.json": "./package.json",
    "./config": "./src/config.ts",
    "./clients": "./src/clients.ts",
    "./seadrop": "./src/seadrop.ts",
    "./snipe": "./src/snipe.ts",
    "./wallets": "./src/wallets.ts",
    "./key": "./src/key.ts",
    "./simulate": "./src/simulate.ts",
    "./opensea": "./src/opensea.ts",
    "./paths": "./src/paths.ts",
    "./fsutil": "./src/fsutil.ts",
    "./chain": "./src/chain.ts"
  },
  "scripts": {
    "status": "tsx src/index.ts status",
    "check": "tsx src/index.ts check",
    "generate": "tsx src/index.ts generate",
    "key": "tsx src/index.ts key",
    "fund": "tsx src/index.ts fund",
    "snipe": "tsx src/index.ts snipe",
    "simulate": "tsx src/index.ts simulate",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "viem": "^2.55.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2"
  }
}
